NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TX_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
# Stay at or below the database pool size.
WORKER_CONCURRENCY=5

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-minimum-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="Orders <orders@example.com>"

LLM_PROVIDER=anthropic
LLM_MODEL_ROUTING=claude-haiku-4-5-20251001
LLM_MODEL_EXTRACTION=claude-sonnet-5
LLM_API_KEY=

LOG_LEVEL=debug
SENTRY_DSN=
