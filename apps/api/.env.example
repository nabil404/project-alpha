# The single env file for the whole repo. Copy to apps/api/.env, then fill in.
#
# Two consumers read it:
#   - the api and worker, through @nestjs/config (validated by env.schema.ts);
#   - docker/compose*.yml, which needs it passed explicitly because compose
#     would otherwise look for docker/.env:
#       docker compose --env-file apps/api/.env -f docker/compose.yml up -d
#     `pnpm dev:up` / `pnpm dev:down` wrap that for local dependencies.
#
# Values here are written for HOST development - apps on the machine, Postgres
# and Redis in docker/compose.dev.yml with their ports published. Inside the
# containers `localhost` would be the container itself, so the `app` base in
# docker/compose.app.yml rebuilds DATABASE_URL, REDIS_URL and APP_URL from the
# Stack section below, and blanks the stack secrets so the app never sees them.
#
# A `$` in any value must be written `$$`: compose interpolates this file.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# ---- Database ----
# Two roles, deliberately. The app and worker connect restricted so that
# row-level security applies to them; a superuser bypasses RLS unconditionally.
# app_runtime is created NOLOGIN by the rls_runtime_role migration; each
# environment then sets its password once, out of band:
#   ALTER ROLE app_runtime LOGIN PASSWORD '...';
# The password below must match APP_RUNTIME_PASSWORD at the bottom of this file.
DATABASE_URL=postgres://app_runtime:APP_RUNTIME_PASSWORD@localhost:5432/project-alpha
# Owner connection, for schema tooling only: db:generate, db:migrate,
# db:verify-rls, the Better Auth CLI, and the CI deploy step. Never given to the
# api or worker containers. Its credentials must match POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB at the bottom of this file.
DATABASE_ADMIN_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/project-alpha
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TX_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
# Stay at or below the database pool size.
WORKER_CONCURRENCY=5

# ---- Auth ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-minimum-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Meta ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Mail, LLM, observability ----
SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="Orders <orders@example.com>"

LLM_PROVIDER=anthropic
LLM_MODEL_ROUTING=claude-haiku-4-5-20251001
LLM_MODEL_EXTRACTION=claude-sonnet-5
LLM_API_KEY=

LOG_LEVEL=debug
SENTRY_DSN=

# ---- Stack ----
# Read by docker/compose*.yml only; env.schema.ts ignores these, and
# docker/compose.app.yml blanks the secrets among them for the api and worker.
DOMAIN=orders.example.com

# Where each role finds the others. The defaults are the compose service names,
# which is right while every role shares one host; set them only once a role
# moves to its own server (docs/deployment.md).
# DB_HOST=postgres
# REDIS_HOST=redis
# API_UPSTREAM=api:3000
# Address the data and api roles publish their ports on: loopback on one host,
# the server's private address once split. Never a public interface.
# BIND_IP=127.0.0.1
# Image tag compose builds or pulls; CI sets it to the commit SHA.
# IMAGE_TAG=local

# Redis requires this password in every stack, so moving it to its own server
# changes nothing. It is embedded in REDIS_URL, so keep it URL-safe:
#   openssl rand -hex 32
REDIS_PASSWORD=REDIS_PASSWORD

# The bootstrap superuser, and therefore the schema owner migrations run as.
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=project-alpha

# The api and worker connect as app_runtime, a non-superuser role so that
# row-level security actually applies to them. docker/postgres-init creates it
# with this password on a fresh volume; docker/compose.yml builds the
# containers' DATABASE_URL from it. On an already-provisioned server the role
# comes from the rls_runtime_role migration instead, created NOLOGIN and without
# a password, so set one once after the first `pnpm --filter api db:migrate`:
#   docker compose --env-file apps/api/.env -f docker/compose.yml exec postgres \
#     psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER ROLE app_runtime LOGIN PASSWORD '<the password below>'"
APP_RUNTIME_PASSWORD=APP_RUNTIME_PASSWORD
