{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify-rls": "node scripts/verify-rls.mjs",
    "db:auth-schema": "better-auth generate --config src/auth/auth.cli.ts --output src/database/schema/auth.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@better-auth/core": "^1.7.5",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.5",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.7",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.5",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  }
}
