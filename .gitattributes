# Normalise line endings to LF in the repo and in every working tree, so
# macOS and Windows checkouts are byte-identical. Shell scripts and Docker
# files break with CRLF ("bad interpreter: /bin/bash^M").
* text=auto eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
