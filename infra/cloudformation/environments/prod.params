# Parameters for stack social-glider-prod (environment.yml). One KEY=VALUE per line.
# Deploy with: infra/cloudformation/deploy.sh prod
EnvName=prod
# Prod has its own bootstrap (bootstrap-prod.yml): its own ECR repositories and
# bundle bucket. It promotes the images stage ran from social-glider-bootstrap's.
BootstrapStackName=social-glider-bootstrap-prod
SourceBootstrapStackName=social-glider-bootstrap
Domain=socialglider.online
# Sized together with docker/compose.prod.yml - change both.
InstanceType=t3.medium
DataVolumeSizeGiB=40
BackupRetentionDays=30
# Pinned: a changed ImageId replaces the instance. deploy.sh prints the current
# Amazon Linux 2023 AMI when this is empty.
ImageId=
