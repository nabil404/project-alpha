# Parameters for stack app-dev (environment.yml). One KEY=VALUE per line.
# Deploy with: infra/cloudformation/deploy.sh dev
EnvName=dev
Domain=dev.socialglider.online
# Sized together with docker/compose.dev.yml - change both.
InstanceType=t3.small
DataVolumeSizeGiB=20
BackupRetentionDays=7
# Pinned: a changed ImageId replaces the instance. deploy.sh prints the current
# Amazon Linux 2023 AMI when this is empty.
ImageId=
AlarmEmail=
