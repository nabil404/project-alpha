# The repo's only env file. Copy to environments/.env and fill it in.
#
# The api and worker read it through @nestjs/config (validated by
# env.schema.ts). Compose reads it only when passed explicitly:
#   docker compose --env-file environments/.env -f docker/compose.yml up -d
# `pnpm dev:up` / `pnpm dev:down` do that for local dependencies.
#
# Values are for host development, with Postgres and Redis from
# docker/compose.local.yml. docker/compose.yml overrides DATABASE_URL, REDIS_URL
# and APP_URL with service hostnames and blanks the stack secrets for the app.
#
# Write a `$` in any value as `$$`, because compose interpolates this file.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# ---- Database ----
# The app connects as app_runtime, a non-superuser, so row-level security
# applies. Its password must match APP_RUNTIME_PASSWORD below.
DATABASE_URL=postgres://app_runtime:APP_RUNTIME_PASSWORD@localhost:5432/project-alpha
# The owner, for schema tooling and the CI deploy step only. Never given to the
# api or worker. Must match the POSTGRES_* values below.
DATABASE_ADMIN_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/project-alpha
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TX_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
# At most DATABASE_POOL_MAX.
WORKER_CONCURRENCY=5

# ---- Auth ----
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Facebook Login app, for sign-in only (docs/setup/meta-setup.md).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Meta ----
# The Messenger app, separate from FACEBOOK_* (docs/setup/meta-setup.md). Its
# valid OAuth redirect URIs must include
# ${APP_URL}/api/v1/messenger/page/oauth/callback. Without META_APP_ID,
# connecting a Page answers MESSENGER_NOT_CONFIGURED.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Mail, LLM, observability ----
# Locally, Mailpit from docker/compose.local.yml (http://localhost:8025). In
# production, a transactional provider's SMTP URL, such as
# smtp://user:pass@smtp.example.com:587.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Orders <orders@example.com>"

# The assistant (docs/setup/llm-setup.md). Without LLM_API_KEY, customers get no
# automatic reply.
LLM_PROVIDER=openai
LLM_MODEL_ROUTING=gpt-6-luna
LLM_MODEL_EXTRACTION=gpt-6.1-sol
LLM_TIMEOUT_MS=15000
# Default languages a seller may pick for the assistant, ISO 639-1, comma-separated.
ASSISTANT_LANGUAGES=en,bn
LLM_API_KEY=
# Optional LangSmith tracing of every LLM call, prompt and output included
# (docs/setup/llm-setup.md#tracing-with-langsmith). Development and stage only:
# never set it in production, where traces would carry real customer chats.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=social-glider-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LOG_LEVEL=debug
SENTRY_DSN=

# ---- Object storage ----
# Product images in Cloudflare R2, through its S3 API. The endpoint is
# https://<account-id>.r2.cloudflarestorage.com. Each environment has its own
# bucket and an Object Read & Write token scoped to it. Never use the
# production token here.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# The bucket's r2.dev URL in development. In production, https://media.<domain>,
# because r2.dev is rate-limited.
STORAGE_PUBLIC_BASE_URL=

# ---- Tests ----
# Read only by the api's Jest run (apps/api/jest.global-setup.mjs), which
# copies just these keys, so specs never touch the dev database or Redis. The
# database's name must end in _test; the run creates it on the Postgres above
# and migrates it. Leave them empty to skip the database- and Redis-backed specs.
TEST_DATABASE_ADMIN_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/project-alpha_test
# A Redis logical database apart from the app's 0.
TEST_REDIS_URL=redis://localhost:6379/15

# ---- Stack ----
# Read only by docker/compose*.yml. docker/compose.yml blanks these for the api
# and worker.
DOMAIN=orders.example.com
# The bootstrap superuser, which owns the schema and runs migrations.
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=POSTGRES_PASSWORD
POSTGRES_DB=project-alpha

# The app_runtime password. docker/postgres-init sets it on a fresh volume. On
# an existing server the rls_runtime_role migration creates the role without
# one, so set it once after the first `pnpm --filter api db:migrate`:
#   docker compose --env-file environments/.env -f docker/compose.yml exec postgres \
#     psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER ROLE app_runtime LOGIN PASSWORD '<the password below>'"
# With NODE_ENV=production the api refuses to start if DATABASE_URL still uses
# this placeholder password.
APP_RUNTIME_PASSWORD=APP_RUNTIME_PASSWORD
