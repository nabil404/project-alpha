{
  "name": "messenger-to-order",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "db:diff": "pnpm --filter api db:diff",
    "db:apply": "pnpm --filter api db:apply",
    "db:types": "pnpm --filter api db:types"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
